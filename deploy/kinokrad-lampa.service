[Unit]
Description=KinoKrad source for Lampa (catalog + signed HLS proxy)
Documentation=https://github.com/myratmyradov1997/kinokrad-lampa-plugin
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lampa
Group=lampa
WorkingDirectory=/opt/lampa/kinokrad
Environment=PORT=5200
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/lampa/playwright
# Единый выход в сеть для Chromium и CDN (необязательно):
# Environment=KK_UPSTREAM_PROXY=http://127.0.0.1:7899
ExecStart=/opt/lampa/kinokrad/.venv/bin/python /opt/lampa/kinokrad/server.py
Restart=always
RestartSec=4
# Chromium открывает больше файловых дескрипторов, чем даёт systemd по умолчанию
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
